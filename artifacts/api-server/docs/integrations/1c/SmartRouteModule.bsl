// ║  ИНСТРУКЦИЯ ПО ПОДКЛЮЧЕНИЮ:                                          ║
// ║   1. В Конфигураторе 1С: Файл -> Новый -> Внешняя обработка         ║
// ║   2. В свойствах обработки укажите Имя: SmartRoute                   ║
// ║   3. Формы -> Добавить -> Произвольная форма -> ОК                  ║
// ║   4. Добавьте 2 команды и вынесите их кнопками на форму:             ║
// ║      • Кнопка «Проверить соединение» -> Команда: СмартРоутПроверить   ║
// ║      • Кнопка «Отправить заявки»     -> Команда: СмартРоутОтправить   ║
// ║      (Опционально) Реквизит формы «ДатаДоставки» (тип: Дата)         ║
// ║   5. Перейдите на вкладку «Модуль» формы и вставьте этот код.        ║
// ║   6. Нажмите Сохранить (*.epf) и откройте в «1С:Предприятие».       ║
// ╚══════════════════════════════════════════════════════════════════════╝

// ══════════════════════════════════════════════════════════════════
// НАСТРОЙКИ ПОДКЛЮЧЕНИЯ
// ══════════════════════════════════════════════════════════════════

&НаСервере
Функция _ПолучитьНастройки()
	Н = Новый Структура;

	// ── 1. Адрес сервера SmartRoute ───────────────────────────────────
	// Укажите адрес сервера (локальный или внешний):
	//  * "http://localhost:8000"
	//  * "http://127.0.0.1:8000"
	//  * "https://smartroute.yourdomain.com"
	Н.Вставить("URL",   "http://localhost:8000");

	// ── 2. API-ключ SmartRoute ────────────────────────────────────────
	Н.Вставить("Ключ",  "sr_live_default_integration_key");

	// ── 3. Город доставки по умолчанию ────────────────────────────────
	Н.Вставить("Город", "Махачкала");

	// ── 4. Автоматическое определение документа и реквизитов ──────────
	РеквизитыКонфигурации = _АвтоопределитьРеквизиты1С();
	Н.Вставить("Документ",  РеквизитыКонфигурации.Документ);
	Н.Вставить("РеквДата",  РеквизитыКонфигурации.РеквДата);
	Н.Вставить("РеквАдрес", РеквизитыКонфигурации.РеквАдрес);
	Н.Вставить("РеквКол",   РеквизитыКонфигурации.РеквКол);
	Н.Вставить("РеквВес",   РеквизитыКонфигурации.РеквВес);

	Возврат Н;
КонецФункции

// ══════════════════════════════════════════════════════════════════
// СОБЫТИЯ ФОРМЫ
// ══════════════════════════════════════════════════════════════════

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Попытка
		ЭтаФорма["ДатаДоставки"] = НачалоДня(ТекущаяДата());
	Исключение
	КонецПопытки;
КонецПроцедуры

// ══════════════════════════════════════════════════════════════════
// КНОПКА 1: ПРОВЕРИТЬ СОЕДИНЕНИЕ
// ══════════════════════════════════════════════════════════════════

&НаКлиенте
Процедура СмартРоутПроверить(Команда)
	Рез = ПроверитьСоединениеНаСервере();
	Сообщить(Рез);
	ПоказатьПредупреждение(, Рез, , "SmartRoute — Проверка соединения");
КонецПроцедуры

&НаСервере
Функция ПроверитьСоединениеНаСервере()
	Н = _ПолучитьНастройки();

	РезультатHTTP = _ВыполнитьЗапрос(Н.URL, "POST", "/api/v1/integration/ping", Н.Ключ);
	Если НЕ РезультатHTTP.Успех Тогда
		РезультатHTTP = _ВыполнитьЗапрос(Н.URL, "GET", "/api/healthz", Н.Ключ);
	КонецЕсли;

	Если РезультатHTTP.Успех Тогда
		КолМаг = "?";
		Попытка
			ОтвМаг = _ВыполнитьЗапрос(Н.URL, "GET", "/api/v1/stores?page_size=1", Н.Ключ);
			Если ОтвМаг.Успех Тогда
				ДанМаг = _ЧтениеJSON(ОтвМаг.Тело);
				Если ТипЗнч(ДанМаг) = Тип("Соответствие") Тогда
					Мета = ДанМаг.Получить("meta");
					Если Мета <> Неопределено Тогда
						Итого = Мета.Получить("total");
						Если Итого <> Неопределено Тогда
							КолМаг = "" + Итого;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		Исключение
		КонецПопытки;

		Возврат "[OK] Соединение со SmartRoute успешно установлено!" + Символы.ПС + Символы.ПС
			+ "Адрес сервера:               " + Н.URL + Символы.ПС
			+ "Магазинов в базе SmartRoute:   " + КолМаг + Символы.ПС
			+ "Определённый документ 1С:      Документ." + Н.Документ + Символы.ПС + Символы.ПС
			+ "Система полностью готова к отправке заявок.";

	Иначе
		Возврат РезультатHTTP.Ошибка;
	КонецЕсли;
КонецФункции

// ══════════════════════════════════════════════════════════════════
// КНОПКА 2: ОТПРАВИТЬ ЗАЯВКИ
// ══════════════════════════════════════════════════════════════════

&НаКлиенте
Процедура СмартРоутОтправить(Команда)
	ВыбраннаяДата = НачалоДня(ТекущаяДата());

	Попытка
		ЗначПоля = ЭтаФорма["ДатаДоставки"];
		Если ЗначениеЗаполнено(ЗначПоля) Тогда
			ВыбраннаяДата = НачалоДня(ЗначПоля);
		КонецЕсли;
	Исключение
	КонецПопытки;

	Рез = ОтправитьЗаявкиНаСервере(ВыбраннаяДата);
	Сообщить(Рез);
	ПоказатьПредупреждение(, Рез, , "SmartRoute — Результат отправки");
КонецПроцедуры

// ══════════════════════════════════════════════════════════════════
// РЕГЛАМЕНТНОЕ ЗАДАНИЕ (ФОНОВАЯ АВТО-СИНХРОНИЗАЦИЯ)
// ══════════════════════════════════════════════════════════════════

&НаСервере
Процедура ОтправитьЗаявки() Экспорт
	ДатаДоставки = НачалоДня(ТекущаяДата());
	Рез = ОтправитьЗаявкиНаСервере(ДатаДоставки);
	ЗаписьЖурналаРегистрации(
		"SmartRoute.Синхронизация",
		УровеньЖурналаРегистрации.Информация,
		, ,
		"Дата: " + Формат(ДатаДоставки, "ДФ=дд.ММ.гггг") + " | " + Рез
	);
КонецПроцедуры

// ══════════════════════════════════════════════════════════════════
// ОСНОВНАЯ ВЫГРУЗКА ЗАКАЗОВ В SMARTROUTE
// ══════════════════════════════════════════════════════════════════

&НаСервере
Функция ОтправитьЗаявкиНаСервере(ДатаДоставки)
	Н = _ПолучитьНастройки();

	Собрано = _СобратьМассивЗаказовИз1С(Н, ДатаДоставки);
	Если Собрано.Ошибка <> Неопределено Тогда
		Возврат Собрано.Ошибка;
	КонецЕсли;

	МассивЗаказов = Собрано.Массив;
	Если МассивЗаказов.Количество() = 0 Тогда
		Возврат "[ИНФО] Нет проведенных заказов на дату "
			+ Формат(ДатаДоставки, "ДФ=дд.ММ.гггг") + "." + Символы.ПС
			+ "Документ: Документ." + Н.Документ + Символы.ПС
			+ "Убедитесь, что документы проведены в 1С.";
	КонецЕсли;

	Тело = Новый Структура;
	Тело.Вставить("orders",             МассивЗаказов);
	Тело.Вставить("replace_date",       Истина);
	Тело.Вставить("auto_create_stores", Истина);

	СтрокаJSON = _ЗаписьJSON(Тело);

	ОтветHTTP = _ВыполнитьЗапрос(Н.URL, "POST", "/api/v1/orders/batch", Н.Ключ, СтрокаJSON);

	Если ОтветHTTP.Успех Тогда
		Данные = _ЧтениеJSON(ОтветHTTP.Тело);

		ЗначСоздано = Неопределено;
		ЗначСовпало = Неопределено;
		ЗначНовых   = Неопределено;
		ЗначПропущ  = Неопределено;

		Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
			ЗначСоздано = Данные.Получить("created");
			ЗначСовпало = Данные.Получить("matched");
			ЗначНовых   = Данные.Получить("auto_created_stores");
			ЗначПропущ  = Данные.Получить("skipped");
		КонецЕсли;

		Создано    = ?(ЗначСоздано <> Неопределено, ЗначСоздано, МассивЗаказов.Количество());
		Совпало    = ?(ЗначСовпало <> Неопределено, ЗначСовпало, 0);
		НовыхТочек = ?(ЗначНовых   <> Неопределено, ЗначНовых,   0);
		Пропущено2 = ?(ЗначПропущ  <> Неопределено, ЗначПропущ,  0);

		Результат = "[OK] Заявки успешно переданы в SmartRoute!" + Символы.ПС + Символы.ПС
			+ "Загружено заявок:          " + Создано    + Символы.ПС
			+ "Совпало точек доставки:    " + Совпало;

		Если НовыхТочек > 0 Тогда
			Результат = Результат + Символы.ПС
				+ "Новых точек создано:       " + НовыхТочек;
		КонецЕсли;

		Если Пропущено2 > 0 Тогда
			Результат = Результат + Символы.ПС
				+ "Пропущено строк:           " + Пропущено2;
		КонецЕсли;

		ЗаписьЖурналаРегистрации("SmartRoute.Синхронизация",
			УровеньЖурналаРегистрации.Информация, , ,
			"Дата: " + Формат(ДатаДоставки, "ДФ=дд.ММ.гггг") + " | " + Результат);
		Возврат Результат;

	Иначе
		Возврат ОтветHTTP.Ошибка;
	КонецЕсли;
КонецФункции

// ══════════════════════════════════════════════════════════════════
// СБОР ДАННЫХ ИЗ БАЗЫ 1С
// ══════════════════════════════════════════════════════════════════

&НаСервере
Функция _СобратьМассивЗаказовИз1С(Н, ДатаДоставки)
	Результат = Новый Структура("Массив, Ошибка", Новый Массив, Неопределено);

	// Проверка наличия метаданных документа
	Если Метаданные.Документы.Найти(Н.Документ) = Неопределено Тогда
		Результат.Ошибка = "[ОШИБКА] Документ «" + Н.Документ + "» не найден в конфигурации 1С." + Символы.ПС
			+ "Укажите имя документа в функции _ПолучитьНастройки().";
		Возврат Результат;
	КонецЕсли;

	ТекстЗапроса =
		"ВЫБРАТЬ"                                                     + Символы.ПС
		+ "|	З.Контрагент.Наименование  КАК Магазин,"               + Символы.ПС
		+ "|	З.Контрагент.Код           КАК КодКонтрагента,"        + Символы.ПС
		+ "|	З.Контрагент.Телефон       КАК Телефон,"               + Символы.ПС
		+ "|	З." + Н.РеквАдрес + "     КАК Адрес,"                 + Символы.ПС
		+ "|	З." + Н.РеквКол   + "     КАК Количество,"            + Символы.ПС
		+ "|	З." + Н.РеквВес   + "     КАК Вес,"                   + Символы.ПС
		+ "|	З.Комментарий              КАК Комментарий,"           + Символы.ПС
		+ "|	З.Номер                    КАК НомерДокумента"         + Символы.ПС
		+ "|ИЗ"                                                       + Символы.ПС
		+ "|	Документ." + Н.Документ + " КАК З"                    + Символы.ПС
		+ "|ГДЕ"                                                      + Символы.ПС
		+ "|	З." + Н.РеквДата + " = &ДатаДоставки"                  + Символы.ПС
		+ "|	И НЕ З.ПометкаУдаления"                               + Символы.ПС
		+ "|	И З.Проведён"                                          + Символы.ПС
		+ "|УПОРЯДОЧИТЬ ПО"                                          + Символы.ПС
		+ "|	З.Контрагент.Наименование";

	ОбъектЗапроса = Новый Запрос;
	ОбъектЗапроса.Текст = ТекстЗапроса;
	ОбъектЗапроса.УстановитьПараметр("ДатаДоставки", ДатаДоставки);

	Попытка
		РезультатТаблица = ОбъектЗапроса.Выполнить().Выгрузить();
	Исключение
		Результат.Ошибка = "[ОШИБКА БД 1С] Не удалось выполнить выборку:" + Символы.ПС
			+ ОписаниеОшибки() + Символы.ПС + Символы.ПС
			+ "Проверьте реквизиты: Документ=" + Н.Документ + ", РеквДата=" + Н.РеквДата + ", РеквАдрес=" + Н.РеквАдрес;
		Возврат Результат;
	КонецПопытки;

	ДатаСтрокой = Формат(ДатаДоставки, "ДФ=гггг-ММ-дд");

	Для Каждого Стр Из РезультатТаблица Цикл
		Если ПустаяСтрока(Стр.Магазин) Тогда Продолжить; КонецЕсли;

		Кол = Стр.Количество;
		Если Кол <= 0 Тогда Кол = 1; КонецЕсли;

		Вес = Стр.Вес;
		Если НЕ ЗначениеЗаполнено(Вес) Тогда Вес = 0; КонецЕсли;

		Заказ = Новый Структура;
		Заказ.Вставить("store_name",        СокрЛП(Стр.Магазин));
		Заказ.Вставить("delivery_date",     ДатаСтрокой);
		Заказ.Вставить("counterparty_code", СокрЛП("" + Стр.КодКонтрагента));
		Заказ.Вставить("address",           СокрЛП("" + Стр.Адрес));
		Заказ.Вставить("city",              Н.Город);
		Заказ.Вставить("phone",             СокрЛП("" + Стр.Телефон));
		Заказ.Вставить("quantity",          Кол);
		Заказ.Вставить("weight_kg",         Вес);
		Заказ.Вставить("products",          СокрЛП("" + Стр.Комментарий));
		Заказ.Вставить("order_number",      СокрЛП("" + Стр.НомерДокумента));
		Заказ.Вставить("external_id",       СокрЛП("" + Стр.НомерДокумента));
		Результат.Массив.Добавить(Заказ);
	КонецЦикла;

	Возврат Результат;
КонецФункции

// ══════════════════════════════════════════════════════════════════
// АВТООПРЕДЕЛЕНИЕ СТРУКТУРЫ КОНФИГУРАЦИИ 1С
// ══════════════════════════════════════════════════════════════════

&НаСервере
Функция _АвтоопределитьРеквизиты1С()
	Рез = Новый Структура;
	Рез.Вставить("Документ",  "ЗаказКлиента");
	Рез.Вставить("РеквДата",  "ДатаДоставки");
	Рез.Вставить("РеквАдрес", "АдресДоставки");
	Рез.Вставить("РеквКол",   "КоличествоМест");
	Рез.Вставить("РеквВес",   "ВесКГ");

	// Кандидаты на имя документа в различных конфигурациях 1С
	СписокДок = Новый Массив;
	СписокДок.Добавить("ЗаказКлиента");
	СписокДок.Добавить("ЗаказПокупателя");
	СписокДок.Добавить("ЗаказНаДоставку");
	СписокДок.Добавить("РеализацияТоваровУслуг");
	СписокДок.Добавить("МаршрутныйЛист");

	Для Каждого ИмяДок Из СписокДок Цикл
		Если Метаданные.Документы.Найти(ИмяДок) <> Неопределено Тогда
			Рез.Документ = ИмяДок;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	ДокМД = Метаданные.Документы.Найти(Рез.Документ);
	Если ДокМД <> Неопределено Тогда
		// Поиск реквизита даты
		КандидатыДаты = Новый Массив;
		КандидатыДаты.Добавить("ДатаДоставки");
		КандидатыДаты.Добавить("ДатаОтгрузки");
		КандидатыДаты.Добавить("ЖелаемаяДатаОтгрузки");
		КандидатыДаты.Добавить("Дата");
		Для Каждого ИмяРекв Из КандидатыДаты Цикл
			Если ИмяРекв = "Дата" Или ДокМД.Реквизиты.Найти(ИмяРекв) <> Неопределено Тогда
				Рез.РеквДата = ИмяРекв;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		// Поиск реквизита адреса
		КандидатыАдреса = Новый Массив;
		КандидатыАдреса.Добавить("АдресДоставки");
		КандидатыАдреса.Добавить("ФактическийАдрес");
		КандидатыАдреса.Добавить("Адрес");
		КандидатыАдреса.Добавить("ПунктДоставки");
		Для Каждого ИмяРекв Из КандидатыАдреса Цикл
			Если ДокМД.Реквизиты.Найти(ИмяРекв) <> Неопределено Тогда
				Рез.РеквАдрес = ИмяРекв;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Рез;
КонецФункции

// ══════════════════════════════════════════════════════════════════
// НАДЁЖНЫЙ HTTP-КЛИЕНТ С ПОДДЕРЖКОЙ REDIRECT И ПОРТОВ
// ══════════════════════════════════════════════════════════════════

&НаСервере
Функция _ВыполнитьЗапрос(URLСервера, Метод, Путь, Ключ, ТелоJSON = "")
	Рез = Новый Структура("Успех, Код, Тело, Ошибка", Ложь, 0, "", "");

	ТекущийURL = СокрЛП(URLСервера);
	ТекущийПуть = Путь;

	Для ШагРедиректа = 1 По 5 Цикл
		ПараметрыURL = _РазобратьURL(ТекущийURL, ТекущийПуть);

		ЗащитаSSL = Неопределено;
		Если ПараметрыURL.HTTPS Тогда
			Попытка
				ЗащитаSSL = Новый ЗащищенноеСоединениеOpenSSL();
			Исключение
				ЗащитаSSL = Неопределено;
			КонецПопытки;
		КонецЕсли;

		Попытка
			Если ЗащитаSSL <> Неопределено Тогда
				Соединение = Новый HTTPСоединение(ПараметрыURL.Хост, ПараметрыURL.Порт, , , , 25, ЗащитаSSL);
			Иначе
				Соединение = Новый HTTPСоединение(ПараметрыURL.Хост, ПараметрыURL.Порт, , , , 25);
			КонецЕсли;

			Заголовки = Новый Соответствие;
			Заголовки.Вставить("Authorization", "Bearer " + Ключ);
			Заголовки.Вставить("Content-Type",  "application/json; charset=utf-8");
			Заголовки.Вставить("Accept",        "application/json");

			HTTPЗапрос = Новый HTTPЗапрос(ПараметрыURL.ПолныйПуть, Заголовки);
			Если Метод = "POST" И НЕ ПустаяСтрока(ТелоJSON) Тогда
				HTTPЗапрос.УстановитьТелоИзСтроки(ТелоJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
				Ответ = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
			Иначе
				Ответ = Соединение.Получить(HTTPЗапрос);
			КонецЕсли;
		Исключение
			Рез.Ошибка = "[ОШИБКА СЕТИ] Не удалось подключиться к " + ПараметрыURL.Хост + ":" + ПараметрыURL.Порт + Символы.ПС
				+ "Описание: " + ОписаниеОшибки() + Символы.ПС + Символы.ПС
				+ "Рекомендация: Убедитесь, что сервер SmartRoute запущен (например: http://localhost:8000).";
			Возврат Рез;
		КонецПопытки;

		Код = Ответ.КодСостояния;
		Рез.Код = Код;
		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
		Рез.Тело = ТелоОтвета;

		// Обработка успешных ответов
		Если Код = 200 Или Код = 201 Тогда
			Рез.Успех = Истина;
			Возврат Рез;
		КонецЕсли;

		// Обработка редиректов 301, 302, 303, 307, 308
		Если Код = 301 Или Код = 302 Или Код = 303 Или Код = 307 Или Код = 308 Тогда
			НовыйАдрес = "";
			Попытка
				НовыйАдрес = Ответ.Заголовки.Получить("Location");
				Если НовыйАдрес = Неопределено Тогда
					НовыйАдрес = Ответ.Заголовки.Получить("location");
				КонецЕсли;
			Исключение
			КонецПопытки;

			// Если попали на страницу проверки Google AI Studio iframe sandbox
			Если СтрНайти(НРег(ТелоОтвета), "cookie_check") > 0 Или СтрНайти(НРег(НовыйАдрес), "cookie_check") > 0 Тогда
				Рез.Ошибка = "[ИНФОРМАЦИЯ О ПОДКЛЮЧЕНИИ]" + Символы.ПС
					+ "Сервер вернул перенаправление Google Cloud Sandbox." + Символы.ПС + Символы.ПС
					+ "Для интеграции с реальной 1С укажите рабочий адрес сервера SmartRoute:" + Символы.ПС
					+ "  * Локальный запуск:  http://localhost:8000" + Символы.ПС
					+ "  * Сервер компании:   https://smartroute.ваша-компания.ru";
				Возврат Рез;
			КонецЕсли;

			Если ЗначениеЗаполнено(НовыйАдрес) Тогда
				Если НРег(Лев(НовыйАдрес, 4)) = "http" Тогда
					ТекущийURL = НовыйАдрес;
					ТекущийПуть = "";
				Иначе
					ТекущийПуть = НовыйАдрес;
				КонецЕсли;
				Продолжить; // Переходим к следующему шагу редиректа
			КонецЕсли;
		КонецЕсли;

		// Обработка кодов ошибок HTTP
		Если Код = 401 Тогда
			Рез.Ошибка = "[ОШИБКА 401] Неверный API-ключ SmartRoute." + Символы.ПС
				+ "Проверьте ключ в настройках обработки.";
		ИначеЕсли Код = 403 Тогда
			Рез.Ошибка = "[ОШИБКА 403] Доступ запрещен (недостаточно прав API-ключа).";
		ИначеЕсли Код = 404 Тогда
			Рез.Ошибка = "[ОШИБКА 404] Эндпоинт " + ПараметрыURL.ПолныйПуть + " не найден на сервере " + ПараметрыURL.Хост;
		ИначеЕсли Код = 422 Тогда
			Рез.Ошибка = "[ОШИБКА 422] Ошибка в структуре данных заявки:" + Символы.ПС + Лев(ТелоОтвета, 400);
		Иначе
			Рез.Ошибка = "[ОШИБКА " + Код + "] Сервер вернул ответ:" + Символы.ПС + Лев(ТелоОтвета, 300);
		КонецЕсли;

		Возврат Рез;
	КонецЦикла;

	Рез.Ошибка = "[ОШИБКА] Превышено максимальное число редиректов (5).";
	Возврат Рез;
КонецФункции

// Парсер URL: извлекает HTTPS, Хост, Порт и Базовый Путь
&НаСервере
Функция _РазобратьURL(URLСтрока, ПутьЗапроса)
	Рез = Новый Структура;
	Рез.Вставить("HTTPS",      Ложь);
	Рез.Вставить("Хост",       "localhost");
	Рез.Вставить("Порт",       8000);
	Рез.Вставить("ПолныйПуть", ПутьЗапроса);

	Очищ = СокрЛП(URLСтрока);
	Если НРег(Лев(Очищ, 8)) = "https://" Тогда
		Рез.HTTPS = Истина;
		Рез.Порт = 443;
		БезСхемы = Сред(Очищ, 9);
	ИначеЕсли НРег(Лев(Очищ, 7)) = "http://" Тогда
		Рез.HTTPS = Ложь;
		Рез.Порт = 80;
		БезСхемы = Сред(Очищ, 8);
	Иначе
		БезСхемы = Очищ;
	КонецЕсли;

	ПозСлэш = СтрНайти(БезСхемы, "/");
	БазовыйПрефикс = "";
	Если ПозСлэш > 0 Тогда
		ХостПорт = Лев(БезСхемы, ПозСлэш - 1);
		БазовыйПрефикс = Сред(БезСхемы, ПозСлэш);
		Если Прав(БазовыйПрефикс, 1) = "/" Тогда
			БазовыйПрефикс = Лев(БазовыйПрефикс, СтрДлина(БазовыйПрефикс) - 1);
		КонецЕсли;
	Иначе
		ХостПорт = БезСхемы;
	КонецЕсли;

	ПозДвоеточие = СтрНайти(ХостПорт, ":");
	Если ПозДвоеточие > 0 Тогда
		Рез.Хост = Лев(ХостПорт, ПозДвоеточие - 1);
		Попытка
			Рез.Порт = Число(Сред(ХостПорт, ПозДвоеточие + 1));
		Исключение
		КонецПопытки;
	Иначе
		Рез.Хост = ХостПорт;
	КонецЕсли;

	Рез.ПолныйПуть = БазовыйПрефикс + ПутьЗапроса;
	Возврат Рез;
КонецФункции

