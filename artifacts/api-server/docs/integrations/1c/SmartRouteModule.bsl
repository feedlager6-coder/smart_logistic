// ╔══════════════════════════════════════════════════════════════════════╗
// ║   SmartRoute — Модуль интеграции 1С:Предприятие 8.3+              ║
// ║   Версия: 3.0  |  https://smartroute.app                           ║
// ╠══════════════════════════════════════════════════════════════════════╣
// ║  КАК УСТАНОВИТЬ В EPF:                                              ║
// ║   1. Конфигуратор → Файл → Новый → Внешняя обработка               ║
// ║   2. Имя: SmartRoute                                                ║
// ║   3. Формы → Добавить → Произвольная форма → ОК                    ║
// ║   4. Разместите элементы формы:                                     ║
// ║      • Кнопка «Проверить соединение» → Команда СмартРоутПроверить  ║
// ║      • Кнопка «Отправить заявки»     → Команда СмартРоутОтправить  ║
// ║      • Поле типа Дата: ПолеДатаДоставки                            ║
// ║   5. Вкладка «Модуль» → вставьте содержимое этого файла            ║
// ║   6. Заполните раздел НАСТРОЙКИ ниже (URL и ключ)                  ║
// ║   7. Файл → Сохранить как → Внешняя обработка (*.epf)              ║
// ║                                                                      ║
// ║  ДЛЯ РЕГЛАМЕНТНОГО ЗАДАНИЯ — используйте ОтправитьЗаявки() Экспорт  ║
// ╚══════════════════════════════════════════════════════════════════════╝

// ══════════════════════════════════════════════════════════════════
// НАСТРОЙКИ — заполните эти поля
// ══════════════════════════════════════════════════════════════════

// Реквизиты вашего документа заказа в 1С — адаптируйте под конфигурацию
Перем URLSmartRoute;          // Адрес сервера SmartRoute
Перем APIКлюч;                // API-ключ SmartRoute
Перем ГородПоУмолчанию;      // Город доставки по умолчанию
Перем ИмяДокументаЗаказа;    // Например: "ЗаказКлиента" или "ЗаказПокупателя"
Перем РеквизитДатыДоставки;  // Например: "ДатаДоставки"
Перем РеквизитАдресаДоставки; // Например: "АдресДоставки"
Перем РеквизитКоличества;    // Например: "КоличествоМест"
Перем РеквизитВеса;          // Например: "ВесКГ"

// ══════════════════════════════════════════════════════════════════

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// ── НАСТРОЙКИ — заполните здесь ────────────────────────────────
	URLSmartRoute            = "https://ВАШ-ДОМЕН.smartroute.app";  // ← адрес SmartRoute
	APIКлюч                  = "sr_live_XXXX-XXXX-XXXX";           // ← API-ключ из архива
	ГородПоУмолчанию         = "Махачкала";

	// ── НАСТРОЙКИ ДОКУМЕНТА — адаптируйте под вашу конфигурацию ───
	ИмяДокументаЗаказа      = "ЗаказКлиента";       // ← имя документа 1С
	РеквизитДатыДоставки    = "ДатаДоставки";        // ← реквизит с датой доставки
	РеквизитАдресаДоставки  = "АдресДоставки";       // ← реквизит с адресом
	РеквизитКоличества      = "КоличествоМест";      // ← реквизит количества мест
	РеквизитВеса            = "ВесКГ";               // ← реквизит веса в кг
	// ─────────────────────────────────────────────────────────────
	Элементы.ПолеДатаДоставки.Значение = НачалоДня(ТекущаяДата());
КонецПроцедуры


// ══════════════════════════════════════════════════════════════════
// КНОПКА: ПРОВЕРИТЬ СОЕДИНЕНИЕ
// ══════════════════════════════════════════════════════════════════

&НаКлиенте
Процедура СмартРоутПроверить(Команда)
	Рез = ПроверитьСоединениеНаСервере();
	Предупреждение(Рез, , "SmartRoute — Проверка соединения");
КонецПроцедуры

&НаСервере
Функция ПроверитьСоединениеНаСервере()
	Если ПустаяСтрока(URLSmartRoute) Или URLSmartRoute = "https://ВАШ-ДОМЕН.smartroute.app" Тогда
		Возврат "⚙️ Не заполнен URLSmartRoute!" + Символы.ПС
			+ "Откройте Модуль формы и укажите адрес сервера SmartRoute.";
	КонецЕсли;

	Если ПустаяСтрока(APIКлюч) Или APIКлюч = "sr_live_XXXX-XXXX-XXXX" Тогда
		Возврат "⚙️ Не заполнен APIКлюч!" + Символы.ПС
			+ "Вставьте ключ из архива SmartRoute или из настроек SmartRoute → API-ключи.";
	КонецЕсли;

	Соединение = _ПолучитьСоединение(URLSmartRoute);

	Попытка
		Запрос = Новый HTTPЗапрос("/api/healthz", _Заголовки(APIКлюч));
		Ответ  = Соединение.Получить(Запрос);
	Исключение
		Возврат "❌ Нет связи с сервером SmartRoute." + Символы.ПС
			+ "Адрес: " + URLSmartRoute + Символы.ПС + Символы.ПС
			+ "Проверьте:" + Символы.ПС
			+ "• Правильность адреса URLSmartRoute" + Символы.ПС
			+ "• Доступ в интернет с этого сервера 1С (порт 443)" + Символы.ПС
			+ "• Брандмауэр / антивирус не блокирует HTTPS" + Символы.ПС + Символы.ПС
			+ "Ошибка: " + ОписаниеОшибки();
	КонецПопытки;

	Если Ответ.КодСостояния = 200 Тогда
		КолМаг = "?";
		Попытка
			ЗапМаг = Новый HTTPЗапрос("/api/v1/stores?page_size=1", _Заголовки(APIКлюч));
			ОтвМаг = Соединение.Получить(ЗапМаг);
			ДанМаг = _ЧтениеJSON(ОтвМаг.ПолучитьТелоКакСтроку());
			Если ТипЗнч(ДанМаг) = Тип("Соответствие") Тогда
				Мета   = ДанМаг.Получить("meta");
				КолМаг = ?(Мета <> Неопределено, СтрШаблон("%1", Мета.Получить("total")), "?");
			КонецЕсли;
		Исключение
		КонецПопытки;

		Возврат "✅ Соединение установлено!" + Символы.ПС + Символы.ПС
			+ "Адрес SmartRoute: " + URLSmartRoute + Символы.ПС
			+ "Магазинов в базе SmartRoute: " + КолМаг + Символы.ПС + Символы.ПС
			+ "Можно настраивать регламентное задание.";

	ИначеЕсли Ответ.КодСостояния = 401 Тогда
		Возврат "❌ Неверный API-ключ." + Символы.ПС + Символы.ПС
			+ "1. Откройте SmartRoute → Интеграции → 1С" + Символы.ПС
			+ "2. Нажмите «Сгенерировать новый пакет»" + Символы.ПС
			+ "3. Скопируйте ключ и вставьте в переменную APIКлюч в этом модуле";

	ИначеЕсли Ответ.КодСостояния = 403 Тогда
		Возврат "❌ Ключ не имеет нужных прав." + Символы.ПС + Символы.ПС
			+ "Ключ должен иметь права: orders:write" + Символы.ПС
			+ "Создайте новый ключ через SmartRoute → Интеграции → 1С";
	Иначе
		Возврат "❌ Сервер ответил кодом " + Ответ.КодСостояния + ":" + Символы.ПС
			+ Лев(Ответ.ПолучитьТелоКакСтроку(), 300);
	КонецЕсли;
КонецФункции


// ══════════════════════════════════════════════════════════════════
// КНОПКА: ОТПРАВИТЬ ЗАЯВКИ (ручной запуск с формы)
// ══════════════════════════════════════════════════════════════════

&НаКлиенте
Процедура СмартРоутОтправить(Команда)
	ДатаДоставки = Элементы.ПолеДатаДоставки.Значение;
	Если НЕ ЗначениеЗаполнено(ДатаДоставки) Тогда
		Предупреждение("Укажите дату доставки!");
		Возврат;
	КонецЕсли;
	Рез = ОтправитьЗаявкиНаСервере(ДатаДоставки);
	Предупреждение(Рез, , "SmartRoute — Результат отправки");
КонецПроцедуры


// ══════════════════════════════════════════════════════════════════
// АВТОЗАПУСК ИЗ РЕГЛАМЕНТНОГО ЗАДАНИЯ
// Создайте регламентное задание:
//   Метод: ОтправитьЗаявки
//   Расписание: ежедневно в 07:30
// ══════════════════════════════════════════════════════════════════

Процедура ОтправитьЗаявки() Экспорт
	ДатаДоставки = НачалоДня(ТекущаяДата());
	Рез = ОтправитьЗаявкиНаСервере(ДатаДоставки);
	ЗаписьЖурналаРегистрации(
		"SmartRoute.Синхронизация",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		"Дата: " + Формат(ДатаДоставки, "ДФ=дд.ММ.гггг") + " | " + Рез
	);
	Сообщить("SmartRoute: " + Рез);
КонецПроцедуры


// ══════════════════════════════════════════════════════════════════
// ОСНОВНАЯ ФУНКЦИЯ ОТПРАВКИ
// ══════════════════════════════════════════════════════════════════

&НаСервере
Функция ОтправитьЗаявкиНаСервере(ДатаДоставки)
	// ── 1. Получить заказы из базы 1С ────────────────────────────────
	// ВАЖНО: Контрагент.Код (counterparty_code) — передавайте ВСЕГДА.
	// Это основной ключ для безошибочного совпадения магазинов в SmartRoute.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	З.Контрагент.Наименование         КАК Магазин,
	|	З.Контрагент.Код                  КАК КодКонтрагента,
	|	З.Контрагент.Телефон              КАК Телефон,
	|	З." + РеквизитАдресаДоставки + " КАК Адрес,
	|	З." + РеквизитКоличества     + " КАК Количество,
	|	З." + РеквизитВеса           + " КАК Вес,
	|	З.Комментарий                     КАК Комментарий,
	|	З.Номер                           КАК НомерДокумента
	|ИЗ
	|	Документ." + ИмяДокументаЗаказа + " КАК З
	|ГДЕ
	|	З." + РеквизитДатыДоставки + " = &ДатаДоставки
	|	И НЕ З.ПометкаУдаления
	|	И З.Проведён
	|УПОРЯДОЧИТЬ ПО
	|	З.Контрагент.Наименование";

	Запрос.УстановитьПараметр("ДатаДоставки", НачалоДня(ДатаДоставки));

	Попытка
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Исключение
		Сообщ = "❌ Ошибка запроса к базе данных:" + Символы.ПС
			+ ОписаниеОшибки() + Символы.ПС + Символы.ПС
			+ "Проверьте названия реквизитов в настройках модуля:" + Символы.ПС
			+ "  ИмяДокументаЗаказа     = " + ИмяДокументаЗаказа + Символы.ПС
			+ "  РеквизитДатыДоставки   = " + РеквизитДатыДоставки + Символы.ПС
			+ "  РеквизитАдресаДоставки = " + РеквизитАдресаДоставки + Символы.ПС
			+ "  РеквизитКоличества     = " + РеквизитКоличества + Символы.ПС
			+ "  РеквизитВеса           = " + РеквизитВеса;
		ЗаписьЖурналаРегистрации("SmartRoute.Ошибка",
			УровеньЖурналаРегистрации.Ошибка, , , Сообщ);
		Возврат Сообщ;
	КонецПопытки;

	Если РезультатЗапроса.Количество() = 0 Тогда
		Возврат "ℹ️ Нет проведённых заказов на " + Формат(ДатаДоставки, "ДФ=дд.ММ.гггг") + "." + Символы.ПС
			+ "Убедитесь, что в реквизите «" + РеквизитДатыДоставки + "»" + Символы.ПС
			+ "стоит дата " + Формат(ДатаДоставки, "ДФ=дд.ММ.гггг") + " и документы проведены.";
	КонецЕсли;

	// ── 2. Сформировать массив заявок ────────────────────────────────
	ДатаСтрокой   = Формат(ДатаДоставки, "ДФ=гггг-ММ-дд");
	МассивЗаказов = Новый Массив;
	Пропущено     = 0;

	Для Каждого Строка Из РезультатЗапроса Цикл
		Если ПустаяСтрока(Строка.Магазин) Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;

		Заказ = Новый Структура;
		Заказ.Вставить("store_name",        СокрЛП(Строка.Магазин));
		Заказ.Вставить("delivery_date",     ДатаСтрокой);
		Заказ.Вставить("counterparty_code", СокрЛП(Строка(Строка.КодКонтрагента)));
		Заказ.Вставить("address",           СокрЛП(Строка.Адрес));
		Заказ.Вставить("city",              ГородПоУмолчанию);
		Заказ.Вставить("phone",             СокрЛП(Строка.Телефон));
		Заказ.Вставить("quantity",          ?(Строка.Количество > 0, Строка.Количество, 1));
		Заказ.Вставить("weight_kg",         ?(ЗначениеЗаполнено(Строка.Вес), Строка.Вес, 0));
		Заказ.Вставить("products",          СокрЛП(Строка.Комментарий));
		Заказ.Вставить("order_number",      СокрЛП(Строка.НомерДокумента));
		Заказ.Вставить("external_id",       СокрЛП(Строка.НомерДокумента));
		МассивЗаказов.Добавить(Заказ);
	КонецЦикла;

	Если МассивЗаказов.Количество() = 0 Тогда
		Возврат "ℹ️ Нет заявок для отправки (все строки без контрагента — " + Пропущено + " шт.)";
	КонецЕсли;

	// ── 3. Отправить в SmartRoute (с повторами при сетевых ошибках) ──
	Тело = Новый Структура;
	Тело.Вставить("orders",             МассивЗаказов);
	Тело.Вставить("replace_date",       Истина);
	Тело.Вставить("auto_create_stores", Истина);

	СтрокаJSON  = _ЗаписьJSON(Тело);
	МаксПопыток = 3;
	ОжиданиеСек = 5;
	Соединение  = _ПолучитьСоединение(URLSmartRoute);
	Ответ       = Неопределено;

	Для НомерПопытки = 1 По МаксПопыток Цикл
		Попытка
			ЗапросHTTP = Новый HTTPЗапрос("/api/v1/orders/batch", _Заголовки(APIКлюч));
			ЗапросHTTP.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8,
				БайтПорядокUnicode.НетМаркера);
			Ответ = Соединение.ОтправитьДляОбработки(ЗапросHTTP);
			Прервать;
		Исключение
			Если НомерПопытки < МаксПопыток Тогда
				ТекВремя = ТекущаяДата();
				Пока ТекущаяДата() - ТекВремя < ОжиданиеСек Цикл
					ОбработкаПрерыванияПользователя();
				КонецЦикла;
			Иначе
				СообщОш = "❌ Нет связи с SmartRoute после " + МаксПопыток + " попыток." + Символы.ПС
					+ "Проверьте доступ в интернет с сервера 1С (порт 443)." + Символы.ПС
					+ "Ошибка: " + ОписаниеОшибки();
				ЗаписьЖурналаРегистрации("SmartRoute.Ошибка",
					УровеньЖурналаРегистрации.Ошибка, , , СообщОш);
				Возврат СообщОш;
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;

	// ── 4. Разобрать ответ сервера ────────────────────────────────────
	Если Ответ.КодСостояния = 200 Или Ответ.КодСостояния = 201 Тогда
		Данные = _ЧтениеJSON(Ответ.ПолучитьТелоКакСтроку());
		Д = ?(Данные.Свойство("data"), Данные["data"], Данные);

		Создано    = ?(Д.Свойство("created"),             Д["created"],             0);
		Совпало    = ?(Д.Свойство("matched"),             Д["matched"],             0);
		НовыхТочек = ?(Д.Свойство("auto_created_stores"), Д["auto_created_stores"], 0);
		Пропущено2 = ?(Д.Свойство("skipped"),             Д["skipped"],             0);

		Результат = "✅ Заявки переданы в SmartRoute!" + Символы.ПС + Символы.ПС
			+ "📦 Загружено заявок:       " + Создано + Символы.ПС
			+ "🏪 Совпало точек доставки: " + Совпало;

		Если НовыхТочек > 0 Тогда
			Результат = Результат + Символы.ПС
				+ "🆕 Новых точек создано:    " + НовыхТочек + Символы.ПС
				+ "   (требуется геокодирование в SmartRoute → Магазины)";
		КонецЕсли;

		Если Пропущено2 > 0 Тогда
			Результат = Результат + Символы.ПС
				+ "⚠️  Пропущено (нет адреса): " + Пропущено2;
		КонецЕсли;

		ЗаписьЖурналаРегистрации("SmartRoute.Синхронизация",
			УровеньЖурналаРегистрации.Информация, , ,
			"Дата: " + Формат(ДатаДоставки, "ДФ=дд.ММ.гггг") + " | " + Результат);
		Возврат Результат;

	ИначеЕсли Ответ.КодСостояния = 401 Тогда
		Возврат "❌ Неверный API-ключ SmartRoute." + Символы.ПС
			+ "Сгенерируйте новый пакет в SmartRoute → Интеграции → 1С.";

	ИначеЕсли Ответ.КодСостояния = 403 Тогда
		Возврат "❌ Ключ не имеет права orders:write." + Символы.ПС
			+ "Создайте новый ключ через SmartRoute → Интеграции → 1С.";

	ИначеЕсли Ответ.КодСостояния = 422 Тогда
		Возврат "❌ Ошибка в данных:" + Символы.ПС
			+ Лев(Ответ.ПолучитьТелоКакСтроку(), 500) + Символы.ПС
			+ "Проверьте названия реквизитов в настройках модуля.";

	ИначеЕсли Ответ.КодСостояния = 429 Тогда
		Возврат "⚠️ Слишком много запросов. Подождите минуту и повторите.";

	Иначе
		Возврат "❌ Сервер SmartRoute вернул ошибку " + Ответ.КодСостояния + ":" + Символы.ПС
			+ Лев(Ответ.ПолучитьТелоКакСтроку(), 300);
	КонецЕсли;
КонецФункции


// ══════════════════════════════════════════════════════════════════
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ (не изменять)
// ══════════════════════════════════════════════════════════════════

&НаСервере
Функция _ПолучитьСоединение(URL)
	HTTPS = НРег(Лев(URL, 8)) = "https://";
	Хост  = СтрЗаменить(СтрЗаменить(URL, "https://", ""), "http://", "");
	ПозСлэш = СтрНайти(Хост, "/");
	Если ПозСлэш > 0 Тогда
		Хост = Лев(Хост, ПозСлэш - 1);
	КонецЕсли;
	Порт = ?(HTTPS, 443, 80);
	Если HTTPS Тогда
		// Ложь = не требовать проверку цепочки сертификатов
		// (нужно для Let's Encrypt на старых ОС 1С / Windows Server 2012)
		ЗащитаSSL = Новый ЗащищённоеСоединениеOpenSSL(Неопределено, Неопределено,
			Неопределено, Ложь);
		Возврат Новый HTTPСоединение(Хост, Порт, , , , 30, ЗащитаSSL);
	Иначе
		Возврат Новый HTTPСоединение(Хост, Порт, , , , 30);
	КонецЕсли;
КонецФункции

