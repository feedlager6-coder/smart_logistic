// ══════════════════════════════════════════════════════════════════
// НАСТРОЙКИ — ЗАПОЛНИТЕ ЗДЕСЬ
// ══════════════════════════════════════════════════════════════════
Перем URLSmartRoute;      // Адрес вашего сервера SmartRoute
Перем APIКлюч;            // API-ключ из SmartRoute → Настройки → API-ключи
Перем ГородПоУмолчанию;  // Город доставки

// Реквизиты вашего документа заказа в 1С
Перем ИмяДокументаЗаказа;      // Например: "ЗаказКлиента"
Перем РеквизитДатыДоставки;    // Например: "ДатаДоставки"
Перем РеквизитАдресаДоставки;  // Например: "АдресДоставки"
Перем РеквизитКоличества;      // Например: "КоличествоМест"
Перем РеквизитВеса;            // Например: "ВесКГ"
// ══════════════════════════════════════════════════════════════════

Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// ── ЗАПОЛНИТЕ НАСТРОЙКИ ──────────────────────────────────────
	URLSmartRoute            = "https://ВАШ_ДОМЕН";    // ← адрес SmartRoute
	APIКлюч                  = "sr_live_XXXX-XXXX";    // ← API-ключ
	ГородПоУмолчанию         = "Махачкала";
	
	ИмяДокументаЗаказа      = "ЗаказКлиента";         // ← имя документа 1С
	РеквизитДатыДоставки    = "ДатаДоставки";          // ← реквизит с датой
	РеквизитАдресаДоставки  = "АдресДоставки";         // ← реквизит с адресом
	РеквизитКоличества      = "КоличествоМест";        // ← реквизит количества
	РеквизитВеса            = "ВесКГ";                 // ← реквизит веса
	// ─────────────────────────────────────────────────────────────
	
	Элементы.ПолеДатаДоставки.Значение = НачалоДня(ТекущаяДата());
КонецПроцедуры


// ══════════════════════════════════════════════════════════════════
// ПРОВЕРКА СОЕДИНЕНИЯ
// ══════════════════════════════════════════════════════════════════

&НаКлиенте
Процедура СмартРоутПроверить(Команда)
	Рез = ПроверитьСоединениеНаСервере();
	Сообщить(Рез);
	Предупреждение(Рез, , "SmartRoute — Проверка соединения");
КонецПроцедуры

&НаСервере
Функция ПроверитьСоединениеНаСервере()
	Если ПустаяСтрока(URLSmartRoute) Или URLSmartRoute = "https://ВАШ_ДОМЕН" Тогда
		Возврат "⚙️ Не заполнен URLSmartRoute!" + Символы.ПС
			+ "Откройте Модуль формы и укажите адрес сервера SmartRoute.";
	КонецЕсли;
	
	Если ПустаяСтрока(APIКлюч) Или APIКлюч = "sr_live_XXXX-XXXX" Тогда
		Возврат "⚙️ Не заполнен APIКлюч!" + Символы.ПС
			+ "Создайте ключ в SmartRoute → Настройки → API-ключи";
	КонецЕсли;
	
	Соединение = _ПолучитьСоединение();
	Запрос     = Новый HTTPЗапрос("/api/v1/keys/me", _Заголовки());
	
	Попытка
		Ответ = Соединение.Получить(Запрос);
	Исключение
		Возврат "❌ Не удалось подключиться к серверу" + Символы.ПС
			+ "Адрес: " + URLSmartRoute + Символы.ПС + Символы.ПС
			+ "Возможные причины:" + Символы.ПС
			+ "• Неверный адрес сервера (URLSmartRoute)" + Символы.ПС
			+ "• Сервер SmartRoute недоступен" + Символы.ПС
			+ "• Нет доступа в интернет с этого сервера 1С" + Символы.ПС
			+ "• Брандмауэр блокирует порт 443" + Символы.ПС + Символы.ПС
			+ "Ошибка: " + ОписаниеОшибки();
	КонецПопытки;
	
	Если Ответ.КодСостояния = 200 Тогда
		Данные = _ЧтениеJSON(Ответ.ПолучитьТелоКакСтроку());
		
		// Получить количество магазинов
		КолМаг = "?";
		Попытка
			ЗапМаг = Новый HTTPЗапрос("/api/v1/stores?page_size=1", _Заголовки());
			ОтвМаг = Соединение.Получить(ЗапМаг);
			ДанМаг = _ЧтениеJSON(ОтвМаг.ПолучитьТелоКакСтроку());
			Если ТипЗнч(ДанМаг) = Тип("Соответствие") Тогда
				Мета   = ДанМаг.Получить("meta");
				КолМаг = ?(Мета <> Неопределено, Мета.Получить("total"), "?");
			КонецЕсли;
		Исключение
		КонецПопытки;
		
		НазваниеКлюча = Данные.Получить("name");
		Возврат "✅ Соединение установлено!" + Символы.ПС + Символы.ПС
			+ "Ключ: " + ?(НазваниеКлюча <> Неопределено, НазваниеКлюча, "OK") + Символы.ПС
			+ "Магазинов в базе SmartRoute: " + КолМаг;
			
	ИначеЕсли Ответ.КодСостояния = 401 Тогда
		Возврат "❌ Неверный API-ключ!" + Символы.ПС + Символы.ПС
			+ "Что сделать:" + Символы.ПС
			+ "1. Откройте SmartRoute → Настройки → API-ключи" + Символы.ПС
			+ "2. Убедитесь, что ключ активен (не отозван)" + Символы.ПС
			+ "3. Скопируйте ключ заново и обновите APIКлюч в модуле";
			
	ИначеЕсли Ответ.КодСостояния = 403 Тогда
		Возврат "❌ Ключ найден, но нет нужных прав." + Символы.ПС + Символы.ПС
			+ "Необходимые права ключа:" + Символы.ПС
			+ "• orders:write" + Символы.ПС
			+ "• webhooks:receive" + Символы.ПС + Символы.ПС
			+ "SmartRoute → Настройки → API-ключи → Обновить ключ";
	Иначе
		Возврат "❌ Сервер вернул ошибку: " + Ответ.КодСостояния + Символы.ПС
			+ Лев(Ответ.ПолучитьТелоКакСтроку(), 300);
	КонецЕсли;
КонецФункции


// ══════════════════════════════════════════════════════════════════
// ОТПРАВКА ЗАЯВОК
// ══════════════════════════════════════════════════════════════════

// Запуск с формы (кнопка на форме)
&НаКлиенте
Процедура СмартРоутОтправить(Команда)
	ДатаДоставки = Элементы.ПолеДатаДоставки.Значение;
	Если НЕ ЗначениеЗаполнено(ДатаДоставки) Тогда
		Предупреждение("Укажите дату доставки!");
		Возврат;
	КонецЕсли;
	
	Рез = ОтправитьЗаявкиНаСервере(ДатаДоставки);
	Предупреждение(Рез, , "SmartRoute — Результат");
КонецПроцедуры

// Запуск из регламентного задания (ежедневно в 07:30)
Процедура ОтправитьЗаявки() Экспорт
	ДатаДоставки = НачалоДня(ТекущаяДата());
	Рез = ОтправитьЗаявкиНаСервере(ДатаДоставки);
	Сообщить("SmartRoute: " + Рез);
КонецПроцедуры

&НаСервере
Функция ОтправитьЗаявкиНаСервере(ДатаДоставки)
	// 1. Получить заказы из базы 1С
	// ─────────────────────────────────────────────────────────────
	// ВНИМАНИЕ: адаптируйте имена реквизитов под вашу конфигурацию
	// ─────────────────────────────────────────────────────────────
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|   З.Контрагент.Наименование    КАК Магазин,
	|   З." + РеквизитАдресаДоставки + " КАК Адрес,
	|   З." + РеквизитКоличества     + " КАК Количество,
	|   З." + РеквизитВеса           + " КАК Вес,
	|   З.Комментарий                КАК Комментарий,
	|   З.Номер                      КАК НомерДокумента
	|ИЗ
	|   Документ." + ИмяДокументаЗаказа + " КАК З
	|ГДЕ
	|   З." + РеквизитДатыДоставки + " = &ДатаДоставки
	|   И НЕ З.ПометкаУдаления
	|   И З.Проведён
	|УПОРЯДОЧИТЬ ПО
	|   З.Контрагент.Наименование";
	
	Запрос.УстановитьПараметр("ДатаДоставки", НачалоДня(ДатаДоставки));
	
	Попытка
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Исключение
		Возврат "❌ Ошибка запроса к базе данных:" + Символы.ПС
			+ ОписаниеОшибки() + Символы.ПС + Символы.ПС
			+ "Вероятно, неверно указаны реквизиты документа в настройках модуля.";
	КонецПопытки;
	
	Если РезультатЗапроса.Количество() = 0 Тогда
		Возврат "ℹ️ Нет заказов на " + Формат(ДатаДоставки, "ДФ=дд.ММ.гггг") + Символы.ПС
			+ Символы.ПС
			+ "Совет: убедитесь, что в реквизите '" + РеквизитДатыДоставки + "'" + Символы.ПС
			+ "документов проставлена дата " + Формат(ДатаДоставки, "ДФ=дд.ММ.гггг");
	КонецЕсли;
	
	// 2. Сформировать массив заявок
	ДатаСтрокой   = Формат(ДатаДоставки, "ДФ=yyyy-MM-dd");
	МассивЗаказов = Новый Массив;
	Пропущено      = 0;
	
	Для Каждого Строка Из РезультатЗапроса Цикл
		Если ПустаяСтрока(Строка.Магазин) Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		
		Заказ = Новый Структура;
		Заказ.Вставить("store_name",    СокрЛП(Строка.Магазин));
		Заказ.Вставить("address",       СокрЛП(Строка.Адрес));
		Заказ.Вставить("city",          ГородПоУмолчанию);
		Заказ.Вставить("delivery_date", ДатаСтрокой);
		Заказ.Вставить("quantity",      ?(Строка.Количество > 0, Строка.Количество, 1));
		Заказ.Вставить("weight_kg",     Строка.Вес);
		Заказ.Вставить("products",      СокрЛП(Строка.Комментарий));
		Заказ.Вставить("external_id",   СокрЛП(Строка.НомерДокумента));
		МассивЗаказов.Добавить(Заказ);
	КонецЦикла;
	
	Если МассивЗаказов.Количество() = 0 Тогда
		Возврат "ℹ️ Нет заявок для отправки" + Символы.ПС
			+ "(все строки без контрагента — " + Пропущено + " шт.)";
	КонецЕсли;
	
	// 3. Отправить HTTP-запрос в SmartRoute
	Тело = Новый Структура;
	Тело.Вставить("orders",        МассивЗаказов);
	Тело.Вставить("delivery_date", ДатаСтрокой);
	
	Соединение = _ПолучитьСоединение();
	ЗапросHTTP = Новый HTTPЗапрос("/api/v1/orders/batch", _Заголовки());
	ЗапросHTTP.УстановитьТелоИзСтроки(
		_ЗаписьJSON(Тело),
		КодировкаТекста.UTF8,
		БайтПорядокUnicode.НетМаркера
	);
	
	Попытка
		Ответ = Соединение.ОтправитьДляОбработки(ЗапросHTTP);
	Исключение
		Возврат "❌ Ошибка сети при отправке в SmartRoute:" + Символы.ПС
			+ ОписаниеОшибки() + Символы.ПС + Символы.ПС
			+ "Проверьте доступ к интернету с сервера 1С (порт 443).";
	КонецПопытки;
	
	// 4. Обработать ответ
	Если Ответ.КодСостояния = 200 Или Ответ.КодСостояния = 201 Тогда
		Данные = _ЧтениеJSON(Ответ.ПолучитьТелоКакСтроку());
		Д = ?(Данные.Свойство("data"), Данные["data"], Данные);
		
		Результат = "✅ Заявки отправлены!" + Символы.ПС + Символы.ПС
			+ "Загружено заявок:  " + Д["imported"]  + " шт." + Символы.ПС
			+ "Найдено магазинов: " + Д["matched"]    + " шт." + Символы.ПС
			+ "Не найдено:        " + Д["unmatched"] + " шт.";
		
		Если Д["unmatched"] > 0 Тогда
			Результат = Результат + Символы.ПС + Символы.ПС
				+ "⚠️ Ненайденные магазины нужно добавить вручную:" + Символы.ПС
				+ "SmartRoute → Магазины → Добавить магазин";
		КонецЕсли;
		Возврат Результат;
		
	ИначеЕсли Ответ.КодСостояния = 401 Тогда
		Возврат "❌ Неверный API-ключ SmartRoute" + Символы.ПС
			+ "Проверьте APIКлюч в модуле формы.";
			
	ИначеЕсли Ответ.КодСостояния = 403 Тогда
		Возврат "❌ Ключ не имеет нужных прав" + Символы.ПС
			+ "Добавьте права: orders:write, webhooks:receive" + Символы.ПС
			+ "SmartRoute → Настройки → API-ключи → Обновить ключ";
			
	ИначеЕсли Ответ.КодСостояния = 422 Тогда
		Возврат "❌ Ошибка в данных:" + Символы.ПС
			+ Лев(Ответ.ПолучитьТелоКакСтроку(), 400) + Символы.ПС + Символы.ПС
			+ "Проверьте реквизиты документа в настройках модуля.";
	Иначе
		Возврат "❌ Сервер SmartRoute вернул ошибку " + Ответ.КодСостояния + ":" + Символы.ПС
			+ Лев(Ответ.ПолучитьТелоКакСтроку(), 300);
	КонецЕсли;
КонецФункции


// ══════════════════════════════════════════════════════════════════
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ (не трогать)
// ══════════════════════════════════════════════════════════════════

&НаСервере
Функция _ПолучитьСоединение()
	URL = URLSmartRoute;
	HTTPS = НачинаетсяС(URL, "https://");
	Хост  = СтрЗаменить(СтрЗаменить(URL, "https://", ""), "http://", "");
	Порт  = ?(HTTPS, 443, 80);
	Если HTTPS Тогда
		// Ложь = не проверять сертификат (для самоподписанных / Let's Encrypt на некоторых ОС)
		ЗащитаSSL = Новый ЗащищённоеСоединениеOpenSSL(,,, Ложь);
		Возврат Новый HTTPСоединение(Хост, Порт, ,, , 30, ЗащитаSSL);
	Иначе
		Возврат Новый HTTPСоединение(Хост, Порт, ,, , 30);
	КонецЕсли;
КонецФункции

&НаСервере
Функция _Заголовки()
	З = Новый Соответствие;
	З.Вставить("Authorization", "Bearer " + APIКлюч);
	З.Вставить("Content-Type",  "application/json; charset=utf-8");
	Возврат З;
КонецФункции

&НаСервере
Функция _ЗаписьJSON(Объект)
	ЗаписьJSON = Новый ЗаписьJSON;
	НастройкиJSON = Новый НастройкиСериализацииJSON;
	НастройкиJSON.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.ЛокальнаяДата;
	Возврат СериализаторXDTO.ЗаписатьJSON(ЗаписьJSON, Объект, НастройкиJSON);
КонецФункции

&НаСервере
Функция _ЧтениеJSON(Строка)
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Строка);
	Возврат ПрочитатьJSON(ЧтениеJSON, Истина);
КонецФункции
