# ─── Database (required) ──────────────────────────────────────────────────────
# PostgreSQL connection string.
# Railway: add the "Postgres" plugin → DATABASE_URL is injected automatically.
DATABASE_URL=postgresql://user:password@localhost:5432/smartroute

# ─── Server port (optional) ──────────────────────────────────────────────────
# FastAPI listens on this port. Railway injects PORT at runtime automatically.
# Default: 8080
PORT=8080

# ─── Geocoding (optional but recommended) ─────────────────────────────────────
# Yandex Geocoder — fast, accurate for Russian cities.
# Without this key, Nominatim (free, 1 req/sec) is used as fallback.
# Get a key at https://developer.tech.yandex.ru/
YANDEX_GEOCODER_API_KEY=your_key_here

# ─── Routing matrices (optional) ─────────────────────────────────────────────
# GraphHopper Matrix API — real road distances per cluster.
# Without this key, OSRM public server is used (free, no key, fair-use).
# Get a key at https://www.graphhopper.com/
GRAPHHOPPER_API_KEY=your_key_here

# Max locations per GraphHopper Matrix request (depends on your plan).
# Free plan = 5 (default). Starter/Pro plans support 25+.
GRAPHHOPPER_CLUSTER_MAX=5

# OSRM self-hosted instance URL (optional, default = public demo server).
# Use this if you have your own OSRM for Dagestan / Russia coverage.
# OSRM_BASE_URL=https://router.project-osrm.org

# ─── CORS (optional) ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Default "*" is fine for single-service Railway deployments (same domain).
# Restrict for production: ALLOWED_ORIGINS=https://smartroute.up.railway.app
ALLOWED_ORIGINS=*

# ─── Tuning (optional) ────────────────────────────────────────────────────────
# OR-Tools VRP time budget per cluster in seconds (default: 2).
# Increase on a powerful server for better route quality on large inputs.
ORTOOLS_TIME_LIMIT_SECONDS=2

# Centroid refinement iterations for sweep clustering (default: 3).
CLUSTER_CENTROID_REFINEMENT_ROUNDS=3
