# ─── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string — required
DATABASE_URL=postgresql://user:password@localhost:5432/smartroute

# Individual PostgreSQL credentials (alternative to DATABASE_URL)
PGHOST=localhost
PGPORT=5432
PGUSER=smartroute
PGPASSWORD=changeme
PGDATABASE=smartroute

# ─── Backend server ──────────────────────────────────────────────────────────
# Port for the FastAPI server (default: 8080)
PORT=8080
