{
  "name": "smartroute-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --config artifacts/smartroute/vite.config.ts",
    "start": "node server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "sync:github": "node scripts/create-pr.mjs"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.5.2",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
